option('boxtype', type : 'combo', choices : ['generic', 'armbox', 'mipsbox'], value : 'generic',
	description : 'Hardware the library is built for')
option('boxmodel', type : 'combo', value : 'generic',
	choices : ['generic',
		'hd60', 'hd61', 'multibox', 'multiboxse', 'hd51', 'bre2ze4k', 'h7', 'e4hdultra', 'protek4k',
		'osmini4k', 'osmio4k', 'osmio4kplus', 'vusolo4k', 'vuduo4k', 'vuduo4kse', 'vuultimo4k',
		'vuuno4k', 'vuuno4kse', 'vuzero4k',
		'vuduo', 'vuduo2', 'gb800se', 'osnino', 'osninoplus', 'osninopro'],
	description : 'Box model, it has to belong to the boxtype')
option('flv2mpeg4', type : 'boolean', value : false,
	description : 'Convert FLV video to MPEG-4 in libeplayer3 (armbox and mipsbox)')
option('webos', type : 'feature', value : 'disabled',
	description : 'Build for LG webOS TVs')
option('webos_protocols', type : 'string', value : '',
	description : 'Directory with the protocol descriptions of webos-wayland-extensions')

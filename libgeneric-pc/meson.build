libgeneric = static_library('generic',
	'hardware_caps.c',
	'dmx.cpp',
	'dmx_file.cpp',
	'video.cpp',
	'audio.cpp',
	'init.cpp',
	'record.cpp',
	'glfb.cpp',
	'hdmi_cec.cpp',
	'mpv_player.cpp',
	'playback_mpv.cpp',
	'platform.cpp',
	c_args : ['-D__STDC_FORMAT_MACROS', '-D__STDC_CONSTANT_MACROS', '-Wfatal-errors'],
	cpp_args : ['-D__STDC_FORMAT_MACROS', '-D__STDC_CONSTANT_MACROS', '-Wfatal-errors'],
	include_directories : [config_inc, hal_inc, include_directories('../common')],
	dependencies : [
		threads_dep,
		rt_dep,
		dependency('openthreads'),
		dependency('libavformat', version : '>= 53.21.1'),
		dependency('libavcodec', version : '>= 54.28.0'),
		dependency('libavutil'),
		dependency('libswresample'),
		dependency('libswscale'),
		dependency('sdl3', version : '>= 3.2.0'),
		dependency('glesv2'),
		dependency('mpv', version : '>= 1.108'),
		dependency('libdrm'),
	],
	pic : true,
)

install_headers(
	'audio_lib.h',
	'dmx_file.h',
	'glfb_priv.h',
	'hdmi_cec.h',
	'hdmi_cec_types.h',
	'linux-uapi-cec.h',
	'mpv_player.h',
	'playback_lib.h',
	'record_lib.h',
	'video_lib.h',
	'video_std.h',
	subdir : 'libgeneric-pc',
)
